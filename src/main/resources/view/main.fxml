<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.MainController" styleClass="cineplanet-root">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="encabezado">
            <children>
                <Label text="CINEPLANET" styleClass="marca-titulo"/>
                <Label text="Gestión de cine" styleClass="marca-sub"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUsuario" styleClass="chip-usuario"/>
                <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="btn, btn-danger"/>
            </children>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="tabInicio" text="Inicio"><content><fx:include source="main_inicio.fxml"/></content></Tab>
                <Tab text="Ventas"><content><fx:include source="main_venta.fxml"/></content></Tab>
                <Tab text="Clientes"><content><fx:include source="main_cliente.fxml"/></content></Tab>
                <Tab text="Salas"><content><fx:include source="main_sala.fxml"/></content></Tab>
                <Tab text="Películas"><content><fx:include source="main_pelicula.fxml"/></content></Tab>
                <Tab text="Productos"><content><fx:include source="main_producto.fxml"/></content></Tab>
                <Tab text="Usuarios"><content><fx:include source="main_usuario.fxml"/></content></Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
