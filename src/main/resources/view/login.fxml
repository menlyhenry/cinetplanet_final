<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane styleClass="login-fondo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.LoginController">
    <children>
        <VBox alignment="CENTER" maxWidth="320.0" maxHeight="360.0" spacing="10.0" styleClass="login-form">
            <children>
                <Label styleClass="login-titulo" text="CinePlanet" />
                <Label styleClass="login-sub" text="Inicio de sesión" />
                <Label text="Usuario" />
                <TextField fx:id="txtUsuario" />
                <Label text="Clave" />
                <PasswordField fx:id="txtClave" />
                <Label fx:id="lblError" styleClass="error-texto" text="" wrapText="true" />
                <Button defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#ingresar" styleClass="btn, btn-primary" text="Ingresar" />
                <Button maxWidth="1.7976931348623157E308" onAction="#cerrar" styleClass="btn, btn-secundario" text="Cerrar" />
            </children>
        </VBox>
    </children>
</StackPane>
