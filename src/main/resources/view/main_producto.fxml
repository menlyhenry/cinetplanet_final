<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.ProductoController">

    <children>

        <VBox layoutX="14.0" layoutY="14.0" spacing="8.0" styleClass="tarjeta" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">

            <children>

                <AnchorPane>
                    <children>

                        <Label layoutX="14.0" layoutY="14.0" styleClass="titulo-pagina" text="Productos" />

                        <Label layoutX="295.0" layoutY="44.0" text="Filtrar Productos" />

                        <TextField fx:id="txtFiltroDato" layoutX="295.0" layoutY="69.0" onAction="#buscar" />

                        <Button layoutX="457.0" layoutY="69.0" mnemonicParsing="false" onAction="#buscar" styleClass="btn, btn-info" text="Buscar" />
                        <Button layoutX="525.0" layoutY="69.0" mnemonicParsing="false" onAction="#editarSeleccionado" styleClass="btn, btn-primary" text="Editar" />
                        <Button layoutX="590.0" layoutY="69.0" mnemonicParsing="false" onAction="#eliminarSeleccionado" styleClass="btn, btn-danger" text="Eliminar" />

                    </children>

                    <padding>
                        <Insets bottom="5.0" />
                    </padding>

                </AnchorPane>

                <HBox maxHeight="1.7976931348623157E308">

                    <children>

                        <AnchorPane>

                            <children>

                                <GridPane layoutY="5.0">

                                    <columnConstraints>

                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />

                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />

                                    </columnConstraints>

                                    <rowConstraints>

                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />

                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />

                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints />

                                    </rowConstraints>

                                    <children>

                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="subtitulo" text="Formulario de Registro" GridPane.columnSpan="2" />

                                        <Label text="Nombre Producto" GridPane.rowIndex="1" />

                                        <TextField fx:id="txtNombreProducto" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Precio (S/)" GridPane.rowIndex="2" />

                                        <TextField fx:id="txtPrecioProducto" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <children>
                                                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#validarFormulario" styleClass="btn, btn-success" text="Guardar" />
                                                <Button mnemonicParsing="false" onAction="#clearForm" styleClass="btn, btn-warning" text="Limpiar" />
                                            </children>
                                        </HBox>

                                        <Label fx:id="lbnMsg" maxWidth="1.7976931348623157E308" text="" GridPane.columnSpan="2" GridPane.rowIndex="4" />

                                    </children>

                                    <padding>
                                        <Insets left="5.0" />
                                    </padding>

                                </GridPane>

                            </children>

                        </AnchorPane>

                        <AnchorPane>

                            <children>

                                <TableView fx:id="tableView" layoutX="6.0" layoutY="30.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0" />

                            </children>

                        </AnchorPane>

                    </children>

                </HBox>

            </children>

        </VBox>

    </children>

</AnchorPane>
